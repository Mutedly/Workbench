{
  "name": "workbench",
  "version": "1.0.0",
  "private": true,
  "description": "Track work hours and calculate expected monthly salary across multiple jobs.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "start": "npm run build && npm --workspace server run start"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
